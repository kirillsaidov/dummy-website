pipeline {
    agent any

	environment {
		PORT = "${params.PORT ?: '8081'}"
	}

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/kirillsaidov/dummy-website.git'
            }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    docker-compose down || true
                    docker-compose up -d --build
                '''
            }
        }
    }
    
    post {
        success {
            sh '''
                echo "Deployment successful! Visit http://localhost:${PORT}"
            '''
        }
        
        failure {
            echo 'Deployment failed!'
        }
        
        always {
            cleanWs()
        }
    }
}


